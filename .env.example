# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# The web config is not secret (it ships to every browser), but it is kept out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: comma-separated Google accounts allowed to use the app. Empty = anyone who signs in.
# Keep this in sync with the list in firestore.rules (the rules are what actually protect the data).
VITE_ALLOWED_EMAILS=you@gmail.com,wife@gmail.com
