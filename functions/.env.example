# Copy to functions/.env (git-ignored) and fill in. Read by Firebase when you deploy.

# Gmail account the reminders come from (needs an app password, see SETUP.md section 6).
GMAIL_USER=yourname@gmail.com

# Who Nessie reminds: "email=Name", comma-separated. The email must be the Google account
# they sign in to the app with. Example: nami@gmail.com=Nami
NESSIE_TO=nami@gmail.com=Nami

# Where the email button points.
APP_URL=https://m4riosvk.github.io/czech-language/

# true = only write to the logs what would be sent. Switch to false once the logs look right.
NESSIE_DRY_RUN=true
