rules_version = '2';

// Each signed-in user can read and write only users/{their uid} and the documents under it.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow-list of Google accounts (lower-case). Replace these with your and your wife's
    // Google addresses before deploying, or make this function `return true;` to let any
    // Google account use the app (each still sees only their own data).
    function allowedEmail() {
      return request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'you@gmail.com',
          'wife@gmail.com'
        ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && allowedEmail();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /progress/{lessonId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
